# ---------------------------------------------------------------------------
# Shared environment template. Copy to `.env` and fill with REAL values locally.
# `.env` is git-ignored; never commit real credentials.
# All values below are FAKE placeholders.
# ---------------------------------------------------------------------------

# --- MySQL (call-tracking / tour data) ---
DB_HOST=db.example.com
DB_PORT=3306
DB_USER=fake_db_user
DB_PASSWORD=FAKE_DB_PASSWORD
DB_NAME=fake_db_name

# --- Qdrant vector DB ---
URL_LINK=http://localhost:6333
QDRANT_API_KEY=FAKE_QDRANT_API_KEY

# --- OpenAI ---
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY

# --- Google Gemini ---
GEMINI_API_KEY=FAKE_GEMINI_API_KEY

# --- Ollama (local LLM server) ---
OLLAMA_HOST=localhost
OLLAMA_API_KEY=ollama

# --- SMTP (e-mail summaries) ---
SMTP_HOST=smtp.yandex.com
SMTP_PORT=587
SMTP_LOGIN=noreply@example.com
SMTP_PASSWORD=FAKE_SMTP_APP_PASSWORD

# --- Netgsm (call-center API) ---
NETGSM_USERCODE=0000000000
NETGSM_PASSWORD=FAKE_NETGSM_PASSWORD
